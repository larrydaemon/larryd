{
  "about": "hanzo.db: HANZO's only database. Tables are created from here and nowhere else.",
  "database": "hanzo.db",
  "tables": {
    "hanzo_locker": {
      "about": "an agent HANZO holds: its folder and the sha256 of its code and manifest, checked on every call and run",
      "columns": [
        ["agent_key", "TEXT PRIMARY KEY"],
        ["name", "TEXT NOT NULL"],
        ["folder", "TEXT NOT NULL"],
        ["code_sha256", "TEXT NOT NULL"],
        ["manifest_sha256", "TEXT NOT NULL"],
        ["registered_at", "TEXT NOT NULL"]
      ]
    },
    "hanzo_runs": {
      "about": "every call and job run, refused ones too; every count HANZO shows is counted here",
      "columns": [
        ["id", "INTEGER PRIMARY KEY AUTOINCREMENT"],
        ["lane", "TEXT NOT NULL"],
        ["account", "TEXT NOT NULL"],
        ["member", "TEXT NOT NULL"],
        ["agent_key", "TEXT NOT NULL"],
        ["job_key", "TEXT NOT NULL DEFAULT ''"],
        ["run", "INTEGER NOT NULL DEFAULT 0"],
        ["state", "TEXT NOT NULL"],
        ["reason", "TEXT NOT NULL DEFAULT ''"],
        ["started_at", "TEXT NOT NULL"],
        ["finished_at", "TEXT NOT NULL DEFAULT ''"],
        ["charged", "INTEGER NOT NULL DEFAULT 0"],
        ["delivery_sha256", "TEXT NOT NULL DEFAULT ''"]
      ]
    }
  }
}
